# Muse API key (or paste it in the editor: menu → Settings)
MUSE_API_KEY=

# Optional: another Muse server (default https://muse.careflow-demo.online)
# MUSE_BASE_URL=

# Optional: require "Authorization: Bearer <token>" for API calls from other apps
# FLOWS_API_TOKEN=

# Optional: max concurrent Muse jobs (default 4)
# MUSE_CONCURRENCY=4

# Nov (nov.ai.vn) – Seedance 2.x video + Seedream 5.x image. Pick "Seedance …" / "Seedream …" on a node.
# Editing this while the server runs is fine – the key is re-read on every job.
NOV_API_KEY=
# Optional: max concurrent Nov jobs (default 10)
# NOV_CONCURRENCY=10
