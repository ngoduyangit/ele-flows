{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ngoduyangit/ele-flows/docs/workflow-spec.schema.json",
  "title": "Workflow spec",
  "description": "Body of POST /api/flows (and PUT /api/flows/:id). See docs/API.md.",
  "type": "object",
  "required": ["name", "nodes"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,64}$", "description": "Stable flow id. Generated when omitted." },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "aspectRatio": { "type": "string", "description": "Applied to generation nodes that don't set one." } }
    },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "edges": {
      "type": "array",
      "description": "Extra explicit connections.",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "$ref": "#/$defs/key" },
          "to": { "$ref": "#/$defs/key" },
          "port": { "type": "string", "description": "Target input port id (see GET /api/spec/kinds)." }
        }
      }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "refs": { "oneOf": [{ "$ref": "#/$defs/key" }, { "type": "array", "items": { "$ref": "#/$defs/key" } }] },
    "node": {
      "type": "object",
      "required": ["key", "kind"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key", "description": "Unique in the spec; used by refs and @key mentions." },
        "kind": { "enum": ["text", "image", "video", "image-generation", "video-generation", "last-frame", "comment"] },
        "label": { "type": "string" },
        "position": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
        "prompt": { "type": "string", "description": "@key mentions insert another node's text or name a reference image (and connect it)." },
        "text": { "type": "string", "description": "text / comment nodes." },
        "aspectRatio": { "enum": ["16:9", "9:16", "1:1", "4:3", "3:4"], "description": "Videos use 16:9 or 9:16." },
        "duration": { "type": "number", "description": "Video seconds; Muse renders 10, 20, 30 or 60 (others snap to the nearest)." },
        "refs": { "$ref": "#/$defs/refs", "description": "Reference images. Muse uses up to 3; more are tiled into a sheet." },
        "startFrame": { "$ref": "#/$defs/key" },
        "endFrame": { "$ref": "#/$defs/key" },
        "which": { "enum": ["first", "last", "time"], "description": "last-frame: which frame to extract (default last)." },
        "at": { "type": "number", "minimum": 0, "description": "last-frame with which=time: seconds from the start." },
        "inputs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/refs" }, "description": "Connect keys to any input port, e.g. {\"video\": \"clip1\"}." },
        "url": { "type": "string", "description": "image / video nodes: http(s), data: or /api/media/... URL." },
        "mimeType": { "type": "string" }
      }
    }
  }
}
